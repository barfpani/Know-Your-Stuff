{
    "manifest_version": 3,
    "name": "Know Your Stuff",
    "version": "1.0",

    "action": {
        "default_popup": "popup/popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://www.flipkart.com/*"
            ],
            "js": [
                "priceParser.js",
                "productNormalizer.js",
                "Flipkart.js",
                "content.js"
            ]
        }
    ],

    "host_permissions": [
        "https://www.flipkart.com/*"
    ]
}